{
  "c_body": "int GetQpAdjPredSize(dsc_cfg_t *dsc_cfg, dsc_state_t *dsc_state, int unit)\n{\n\tint pred_size, max_size;\n\tint qlevel_old, qlevel_new;\n\tint cpnt;\n\n\tcpnt = dsc_state->unitCType[unit];\n\tqlevel_new = MapQpToQlevel(dsc_cfg, dsc_state, dsc_state->primaryQp, cpnt);\n\n\t// *MODEL NOTE* MN_DSU_SIZE_PREDICTION\n\tpred_size = dsc_state->predictedSize[unit];\n\n\tqlevel_old = MapQpToQlevel(dsc_cfg, dsc_state, dsc_state->prevPrimaryQp, cpnt);\n\n\tpred_size += qlevel_old - qlevel_new;\n\tmax_size = MaxResidualSize(dsc_cfg, dsc_state, cpnt, dsc_state->primaryQp);\n\tpred_size = CLAMP(pred_size, 0, max_size-1);\n\n\treturn (pred_size);\n}",
